# ── ngfw-matcher environment ────────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in. Docker Compose reads it automatically.

# Session cookie signing key — REQUIRED in production (32+ random bytes).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, an ephemeral key is generated at startup and sessions reset on restart.
NGFW_SECRET_KEY=

# Validate the upstream PT NGFW TLS certificate (1/0). Default 0 (self-signed SU).
NGFW_VERIFY_SSL=0

# Mark the session cookie as Secure (1). Enable once the app is served over HTTPS.
NGFW_COOKIE_SECURE=0

# Max uploaded snapshot size, MB.
NGFW_MAX_UPLOAD_MB=64

# Session cookie lifetime, seconds (default 12h).
NGFW_SESSION_MAX_AGE=43200

# Bind host/port for the `ngfw-matcher-web` entry point (non-docker runs only).
NGFW_HOST=127.0.0.1
NGFW_PORT=8080
